{
  "name": "vayztech-links",
  "version": "1.0.0",
  "private": true,
  "description": "Apple-inspired monochrome link-in-bio built for Cloudflare Pages + D1",
  "scripts": {
    "dev": "wrangler pages dev . --d1=DB --port 8788",
    "db:init:local": "wrangler d1 execute vayztech-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute vayztech-db --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy . --project-name=vayztech"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
